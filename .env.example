# .env.example
# Copy this file to .env and replace the placeholder values.
# NEVER commit .env to version control — it contains secrets.

# Port the Express server listens on
PORT=3000

# Node environment: 'development' or 'production'
# In production: WS auth is required, JSON logging is used, HSTS is enabled
NODE_ENV=development

# HMAC signing secret for auth tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. In production use 64+ random characters.
JWT_SECRET=change-me-to-a-64-char-random-string-before-deploying

# Comma-separated list of allowed CORS origins (required in production)
# Leave blank to allow all origins in development
ALLOWED_ORIGINS=http://localhost:3000

# Minimum log level: DEBUG | HTTP | INFO | WARN | ERROR
# Development default: DEBUG
# Production recommended: INFO
LOG_LEVEL=INFO

# Weather provider configuration
# For production/commercial use, configure the licensed Open-Meteo customer endpoint and key.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=
# Shared secret required for analyst/admin token issuance.
# Store this only in the deployment environment; never commit the real value.
ANALYST_AUTH_SECRET=replace-with-a-long-random-secret
